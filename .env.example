# App settings. Copy to .env (git-ignored). Restart `npx expo start` after changing.

# Where the app finds the SaveMan API. Leave unset to use port 4000 on the computer running
# the Expo dev server (works for the browser and for Expo Go on the same Wi-Fi).
# Set it when that doesn't work, e.g. tunnel mode or a different Wi-Fi setup.
# Use your computer's Wi-Fi IPv4 address (Windows: run `ipconfig`, look under "Wireless LAN adapter Wi-Fi").
# EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
