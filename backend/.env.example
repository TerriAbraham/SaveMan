# SaveMan API settings. Copy to backend/.env (git-ignored) and change as needed.
# Every value is optional in development.

# Port the API listens on. The app expects 4000 unless EXPO_PUBLIC_API_URL says otherwise.
PORT=4000

# 0.0.0.0 listens on every network adapter, so a phone on the same Wi-Fi can connect.
HOST=0.0.0.0

# SQLite database file. Default: backend/data/saveman.db (created and seeded on first start).
# DB_PATH=./data/saveman.db

# 32 bytes (64 hex or 44 base64 characters) used to encrypt MFA secrets. REQUIRED in production.
# In development it's generated once into backend/data/master.key if not set.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MFA_MASTER_KEY=

# Online database (Turso, SQLite in the cloud). Set both to use it instead of the local file,
# e.g. when the API is hosted on Render. Get them from the Turso dashboard.
# TURSO_DATABASE_URL=libsql://saveman-yourname.turso.io
# TURSO_AUTH_TOKEN=

# Number of proxies in front of the API, so rate limits see each visitor's real IP. 1 on Render, 0 on your PC.
# TRUST_PROXY=1

# Email for login codes and password resets, sent with Brevo (free: brevo.com, 300 emails a day).
# In Brevo: Senders, domains & IPs > add and verify the address below, then SMTP & API > API keys.
# Without these, codes are printed in this server's log and shown in the app instead of emailed.
# BREVO_API_KEY=xkeysib-...
# EMAIL_FROM=you@gmail.com
